{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/garminlike/benchmark.schema.json",
  "title": "Taiwan Vehicle Route Benchmark Dataset - Stage 0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testCase"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lng",
        "name"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "name": {
          "type": "string"
        },
        "snapToleranceMeters": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentRef",
        "direction",
        "sourceType"
      ],
      "properties": {
        "segmentRef": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string"
        },
        "sourceType": {
          "enum": [
            "OSM_WAY_ID",
            "GEOMETRY_CORRIDOR",
            "OFFICIAL_SEGMENT_ID",
            "ROAD_NAME_HINT"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "legalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "documentTitle",
        "url",
        "verifiedAt",
        "verificationStatus"
      ],
      "properties": {
        "authority": {
          "type": "string"
        },
        "documentTitle": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "effectiveAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifiedAt": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "verificationStatus": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "RECHECK_REQUIRED"
          ]
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mustForbidSegments",
        "mustAllowSegments",
        "mustTraverseSegments",
        "expectedWarningOnUnknownData",
        "legalExpectation"
      ],
      "properties": {
        "mustForbidSegments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "mustAllowSegments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "mustTraverseSegments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "expectedWarningOnUnknownData": {
          "type": "boolean"
        },
        "legalExpectation": {
          "enum": [
            "ALLOWED",
            "FORBIDDEN",
            "UNKNOWN"
          ]
        },
        "comments": {
          "type": "string"
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "title",
        "description",
        "legalReference",
        "origin",
        "destination",
        "waypoints",
        "vehicleType",
        "expectedOutcome"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "legalReference": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legalRef"
          }
        },
        "origin": {
          "$ref": "#/$defs/point"
        },
        "destination": {
          "$ref": "#/$defs/point"
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "vehicleType": {
          "enum": [
            "CAR",
            "SCOOTER",
            "HEAVY_MOTORCYCLE"
          ]
        },
        "vehicleAttributes": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "expectedOutcome": {
          "$ref": "#/$defs/outcome"
        }
      }
    }
  }
}
